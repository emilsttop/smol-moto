---
// Первый экран. Курсор «едет» по фото как колесо эндуро: за ним остаётся след протектора,
// который заносит на резких поворотах и плавно тает.
import Pic from './Pic.astro';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site } from '../config';
const words = ['Сядете', 'и поедете', 'через', '10 минут'];
---
<header class="hero">
  <div class="hero__frame" data-tread>
    <Pic id="hero" eager sizes="(max-width: 700px) 180vw, 96vw" class="hero__pic" />
    <div class="hero__shade" aria-hidden="true"></div>
    <canvas class="hero__tread" aria-hidden="true" data-tread-canvas></canvas>

    <nav class="hero__nav" aria-label="Разделы">
      <ul class="hero__links">
        <li><a href="#call">Забронировать</a></li>
        <li><a href="#reviews">Отзывы</a></li>
        <li><a href="#faq">Вопросы</a></li>
      </ul>
      <a href="/" class="hero__logo" aria-label="Прокат электромотоциклов, Смоленск. На главную" data-dust>
        <Logo size={36} />
        <canvas class="hero__dust" aria-hidden="true" data-dust-canvas></canvas>
      </a>
      <div class="hero__right">
        <a class="hero__phone" href={`tel:${site.phone}`} aria-label={`Позвонить ${site.phoneDisplay}`}><Icon name="phone" size={16} /><span>{site.phoneDisplay}</span></a>
      </div>
    </nav>

    <div class="hero__content">
      <h1 class="hero__title">
        {words.map((w, i) => (
          <>
            <span class="hero__word" style={`--i:${i}`}>{w}</span>
            {i === 1 && <br class="hide-sm" />}
          </>
        ))}
      </h1>
      <p class="hero__sub">
        Даже если вы ни разу не сидели на мотоцикле. Инструктор рядом,
        <br class="hide-sm" />маршрут через лес, поля и берег реки.
      </p>
      <div class="hero__cta">
        <a class="btn btn--cream" href="#call">Подобрать время</a>
        <p class="hero__gift"><Icon name="bolt" size={16} />Фото и видео поездки дарим каждому</p>
      </div>
    </div>
  </div>
</header>

<style>
  .hero { padding: var(--gutter) var(--gutter) 0; }
  .hero__frame {
    position: relative;
    min-height: min(92svh, 980px);
    border-radius: 4px;
    overflow: hidden;
    color: var(--cream);
    display: grid;
    grid-template-rows: auto 1fr;
    isolation: isolate;
  }
  :global(.hero__pic) { position: absolute !important; inset: 0; z-index: -3; aspect-ratio: auto !important; }
  .hero__shade {
    position: absolute; inset: 0; z-index: -2; pointer-events: none;
    background:
      radial-gradient(70% 55% at 50% 64%, rgb(4 10 6 / 0.55), transparent 75%),
      linear-gradient(to bottom, rgb(4 10 6 / 0.7), rgb(4 10 6 / 0.15) 26%, rgb(4 10 6 / 0.25) 45%, rgb(4 10 6 / 0.85) 92%);
  }
  /* след протектора рисуется поверх фото, но под текстом */
  .hero__tread { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; pointer-events: none; }

  .hero__nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 22px clamp(18px, 2.4vw, 34px);
  }
  .hero__links { display: flex; gap: 28px; list-style: none; margin: 0; padding: 0; }
  .hero__links a, .hero__phone {
    font: 500 10.5px/1 var(--f-label); letter-spacing: 0.14em; text-transform: uppercase; text-decoration: none;
  }
  .hero__links a { opacity: 0.85; transition: opacity 0.2s; }
  .hero__links a:hover { opacity: 1; text-decoration: underline; text-underline-offset: 6px; }

  /* название на тёмной плашке, без значка */
  .hero__logo {
    text-decoration: none;
    padding: 14px 26px 13px;
    border-radius: 18px;
    background: rgb(6 14 9 / 0.72);
    border: 1px solid rgb(244 240 226 / 0.18);
  }
  .hero__logo :global(.logo__mark) { display: none; }
  .hero__logo { position: relative; }
  /* название из частиц: canvas шире плашки, чтобы частицы могли разлетаться за её край */
  .hero__dust { position: absolute; left: -60px; top: -40px; width: calc(100% + 120px); height: calc(100% + 80px); pointer-events: none; }
  .hero__logo.is-dust :global(.logo__name) { color: transparent; }
  .hero__logo :global(.logo__text) { justify-items: center; text-align: center; }
  .hero__right { display: flex; justify-content: flex-end; align-items: center; gap: 26px; }
  .hero__phone {
    display: inline-flex; align-items: center; gap: 9px; white-space: nowrap;
    padding: 11px 16px 10px; border: 1px solid rgb(244 240 226 / 0.55); border-radius: 999px;
    font-size: 12px; letter-spacing: 0.06em; transition: background-color 0.25s, color 0.25s;
  }
  .hero__phone:hover { background: var(--cream); color: var(--ink); }

  .hero__content {
    align-self: end;
    display: grid;
    justify-items: center;
    text-align: center;
    padding: 0 clamp(18px, 4vw, 60px) clamp(28px, 4vw, 52px);
    text-shadow: 0 1px 18px rgb(0 0 0 / 0.45);
  }
  .hero__title {
    font-size: clamp(54px, 8.6vw, 150px);
    line-height: 0.9;
    letter-spacing: -0.035em;
  }
  .hero__word {
    display: inline-block;
    margin-inline: 0.03em;
    animation: word-in 1.2s var(--ease-out) both;
    animation-delay: calc(1.15s + var(--i) * 0.09s);
  }
  @keyframes word-in {
    from { opacity: 0; transform: translateY(0.35em); filter: blur(8px); }
  }
  .hero__sub { margin-top: 24px; font-size: 16px; line-height: 1.5; }
  .hero__cta {
    width: 100%;
    margin-top: 34px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }
  .hero__gift { display: inline-flex; align-items: center; gap: 10px; font-size: 14px; }
  .hero__gift :global(svg) { color: var(--accent); }

  @media (max-width: 860px) {
    .hero__links { display: none; }
    .hero__nav { grid-template-columns: 1fr auto; gap: 12px; padding: 16px; }
    .hero__logo { padding: 10px 14px; border-radius: 14px; }
    .hero__logo :global(.logo__text) { justify-items: start; text-align: left; }
    .hero__logo :global(.logo__name) { font-size: 15px; white-space: normal; max-width: 9.5em; line-height: 1.05; }
    .hero__logo :global(.logo__sub) { display: none; }
    .hero__phone { width: 44px; height: 44px; padding: 0; justify-content: center; }
    .hero__phone span { display: none; }
    .hero__content { justify-items: start; text-align: left; }
    .hero__word { margin-inline: 0 0.18em; }
    .hero__cta { flex-direction: column; align-items: flex-start; }
    .hide-sm { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__word { animation: none; }
    .hero__tread { display: none; }
  }
</style>

<script>
  // Название на плашке из частиц: при загрузке частицы слетаются в буквы,
  // при наведении разбегаются от курсора и собираются обратно.
  {
    const plate = document.querySelector<HTMLElement>('[data-dust]');
    const cv = plate?.querySelector<HTMLCanvasElement>('[data-dust-canvas]');
    const nameEl = plate?.querySelector<HTMLElement>('.logo__name');
    if (plate && cv && nameEl && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const ctx = cv.getContext('2d')!;
      type P = { x: number; y: number; vx: number; vy: number; hx: number; hy: number; a: number };
      let parts: P[] = [];
      let raf = 0, mx = -1e4, my = -1e4, dpr = 1;

      const build = () => {
        dpr = Math.min(devicePixelRatio || 1, 2);
        const cb = cv.getBoundingClientRect();
        cv.width = Math.round(cb.width * dpr); cv.height = Math.round(cb.height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        // рисуем название тем же шрифтом во внеэкранный canvas и берём точки из закрашенных пикселей
        const nb = nameEl.getBoundingClientRect();
        const cs = getComputedStyle(nameEl);
        const fs = parseFloat(cs.fontSize);
        const off = document.createElement('canvas');
        const S = 3; // пикселей на CSS-пиксель при выборке, для чёткости
        off.width = Math.ceil(nb.width * S); off.height = Math.ceil(nb.height * S);
        const o = off.getContext('2d')!;
        o.scale(S, S);
        o.font = `${cs.fontStyle} ${cs.fontWeight} ${fs}px ${cs.fontFamily}`;
        o.fillStyle = '#fff';
        o.textBaseline = 'alphabetic';
        // перенос строк такой же, как у DOM-текста: по словам, в ширину элемента
        const words = (nameEl.textContent || '').trim().split(/\s+/);
        const lines: string[] = [];
        let cur = '';
        for (const w of words) {
          const t = cur ? `${cur} ${w}` : w;
          // переносим, только если DOM-текст тоже переносится (на телефоне), иначе одна строка
          if (cs.whiteSpace !== 'nowrap' && o.measureText(t).width > nb.width + 1 && cur) { lines.push(cur); cur = w; } else cur = t;
        }
        lines.push(cur);
        const lh = nb.height / lines.length;
        const align = cs.textAlign;
        lines.forEach((ln, i) => {
          const wdt = o.measureText(ln).width;
          const x = align === 'center' || lines.length === 1 ? (nb.width - wdt) / 2 : 0;
          o.fillText(ln, x, i * lh + lh * 0.78);
        });
        const img = o.getImageData(0, 0, off.width, off.height).data;
        const step = 1.15; // CSS px между частицами
        const ox = nb.left - cb.left, oy = nb.top - cb.top;
        const old = parts;
        parts = [];
        for (let y = 0; y < nb.height; y += step) {
          for (let x = 0; x < nb.width; x += step) {
            const k = (Math.floor(y * S) * off.width + Math.floor(x * S)) * 4 + 3;
            if (img[k] > 120) {
              const prev = old[parts.length];
              parts.push({
                hx: ox + x, hy: oy + y,
                // стартуем из случайной точки вокруг плашки, как облако пыли
                x: prev ? prev.x : ox + nb.width / 2 + (Math.random() - 0.5) * cb.width * 1.4,
                y: prev ? prev.y : oy + nb.height / 2 + (Math.random() - 0.5) * cb.height * 1.6,
                vx: 0, vy: 0, a: 0.75 + Math.random() * 0.25,
              });
            }
          }
        }
        plate.classList.add('is-dust');
        kick();
      };

      const tick = () => {
        const w = cv.width / dpr, h = cv.height / dpr;
        ctx.clearRect(0, 0, w, h);
        let moving = false;
        for (const p of parts) {
          // пружина к своей точке в букве
          p.vx += (p.hx - p.x) * 0.06;
          p.vy += (p.hy - p.y) * 0.06;
          // отталкивание от курсора
          const dx = p.x - mx, dy = p.y - my, d2 = dx * dx + dy * dy;
          if (d2 < 900) { const f = (900 - d2) / 900 * 2.2; const d = Math.sqrt(d2) || 1; p.vx += dx / d * f; p.vy += dy / d * f; }
          p.vx *= 0.8; p.vy *= 0.8;
          p.x += p.vx; p.y += p.vy;
          if (Math.abs(p.vx) + Math.abs(p.vy) > 0.02 || Math.abs(p.hx - p.x) + Math.abs(p.hy - p.y) > 0.3) moving = true;
          ctx.fillStyle = `rgba(244, 240, 226, ${p.a})`;
          ctx.fillRect(p.x, p.y, 1.25, 1.25);
        }
        raf = moving ? requestAnimationFrame(tick) : 0;
      };
      const kick = () => { if (!raf) raf = requestAnimationFrame(tick); };

      plate.addEventListener('pointermove', (e) => {
        const b = cv.getBoundingClientRect();
        mx = e.clientX - b.left; my = e.clientY - b.top;
        kick();
      });
      plate.addEventListener('pointerleave', () => { mx = my = -1e4; kick(); });
      // ждём шрифты, иначе буквы соберутся системным шрифтом; стартуем после заставки
      document.fonts.ready.then(() => setTimeout(build, 500));
      let rt = 0;
      addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(build, 200); });
    }
  }

  const frame = document.querySelector<HTMLElement>('[data-tread]');
  const canvas = frame?.querySelector<HTMLCanvasElement>('[data-tread-canvas]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (frame && canvas && !reduce) {
    const ctx = canvas.getContext('2d')!;
    const LIFE = 2600;     // мс, за сколько след тает
    const STEP = 7;        // px между грунтозацепами
    const HALF = 13;       // половина ширины колеи
    type Mark = { x: number; y: number; a: number; skid: number; t: number; side: number };
    type Clod = { x: number; y: number; vx: number; vy: number; r: number; t: number };
    const marks: Mark[] = [];
    const clods: Clod[] = [];
    let last: { x: number; y: number; a: number } | null = null;
    let lastMove = -1e9, raf = 0, visible = true, dpr = 1, w = 0, h = 0, n = 0;
    const size = () => {
      dpr = Math.min(devicePixelRatio || 1, 2);
      const b = frame.getBoundingClientRect();
      w = b.width; h = b.height;
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    size();
    addEventListener('resize', size);

    // продвигаем «колесо» к точке и раскладываем грунтозацепы через равные промежутки
    const drive = (x: number, y: number, now: number) => {
      if (!last) { last = { x, y, a: 0 }; return; }
      let dx = x - last.x, dy = y - last.y;
      let dist = Math.hypot(dx, dy);
      if (dist < STEP) return;
      const a = Math.atan2(dy, dx);
      // занос: чем резче поворот, тем сильнее зацепы разворачивает поперёк колеи
      let turn = a - last.a;
      turn = Math.atan2(Math.sin(turn), Math.cos(turn));
      const skid = Math.max(-0.9, Math.min(0.9, turn * 2.4));
      while (dist >= STEP) {
        last.x += (dx / dist) * STEP;
        last.y += (dy / dist) * STEP;
        n++;
        marks.push({ x: last.x, y: last.y, a, skid, t: now, side: n % 2 ? 1 : -1 });
        if (Math.abs(skid) > 0.45 && Math.random() < 0.6) {
          // на заносе из-под колеса летят комья
          const out = a + Math.PI / 2 * Math.sign(skid) + (Math.random() - 0.5);
          const sp = 1.5 + Math.random() * 3;
          clods.push({ x: last.x, y: last.y, vx: Math.cos(out) * sp, vy: Math.sin(out) * sp - 1, r: 1 + Math.random() * 2.2, t: now });
        }
        dx = x - last.x; dy = y - last.y; dist = Math.hypot(dx, dy);
      }
      last.a = a;
      if (marks.length > 900) marks.splice(0, marks.length - 900);
    };

    const draw = (now: number) => {
      ctx.clearRect(0, 0, w, h);
      while (marks.length && now - marks[0].t > LIFE) marks.shift();
      for (const m of marks) {
        const life = 1 - (now - m.t) / LIFE;
        const nx = Math.cos(m.a + Math.PI / 2), ny = Math.sin(m.a + Math.PI / 2);
        ctx.save();
        ctx.translate(m.x + nx * HALF * 0.45 * m.side, m.y + ny * HALF * 0.45 * m.side);
        // ёлочка протектора: зацепы наклонены в разные стороны по очереди
        ctx.rotate(m.a + Math.PI / 2 + m.side * 0.42 + m.skid);
        // белый след: чуть прозрачный, чтобы фото проступало сквозь грунтозацепы
        ctx.fillStyle = `rgba(255, 255, 255, ${0.78 * life})`;
        ctx.fillRect(-6.5, -2.4, 13, 4.8);
        ctx.restore();
      }
      for (let i = clods.length - 1; i >= 0; i--) {
        const c = clods[i];
        const age = now - c.t;
        if (age > 900) { clods.splice(i, 1); continue; }
        c.vy += 0.18; c.x += c.vx; c.y += c.vy;
        ctx.fillStyle = `rgba(255, 255, 255, ${0.7 * (1 - age / 900)})`;
        ctx.beginPath(); ctx.arc(c.x, c.y, c.r, 0, Math.PI * 2); ctx.fill();
      }
      // рисуем, только пока на экране есть след или летят комья; новое движение мыши запустит цикл снова
      raf = visible && (marks.length || clods.length) ? requestAnimationFrame(draw) : 0;
    };

    if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
      frame.addEventListener('pointermove', (e) => {
        const b = frame.getBoundingClientRect();
        if (now() - lastMove > 2500) last = null; // после автопилота начинаем новую колею от курсора
        lastMove = now();
        drive(e.clientX - b.left, e.clientY - b.top, lastMove);
        if (visible && !raf) raf = requestAnimationFrame(draw);
      });
    }
    function now() { return performance.now(); }

    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && !raf) raf = requestAnimationFrame(draw);
    }).observe(frame);
  }
</script>
