# Порт, на котором слушает API (nginx проксирует /api сюда)
PORT=8787
HOST=127.0.0.1
# Файл базы заявок
DB_PATH=/var/lib/moto-smolensk/leads.db
# Соль для хэша IP: любая длинная случайная строка
IP_SALT=change-me-to-random-string
# Разрешённый origin сайта для CORS
SITE_ORIGIN=https://moto-smolensk.ru
# Unisender Go: ключ, отправитель (домен подтверждается в кабинете Unisender) и получатель заявок
UNISENDER_API_KEY=
UNISENDER_API_URL=https://go1.unisender.ru/ru/transactional/api/v1/email/send.json
MAIL_FROM=noreply@moto-smolensk.ru
MAIL_TO=publik.emil@gmail.com
LOG_LEVEL=info
