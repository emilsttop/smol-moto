---
// Маршрут поездки, привязанный к прокрутке: трек прорисовывается, по нему едет огонёк фары,
// остановки загораются по мере прохождения.
import { site } from '../config';
const stops = [
  { t: 'Заранее', h: 'Звонок', d: 'Подберём время и формат, назовём стоимость' },
  { t: '0:00', h: 'Трансфер', d: `Заберём: ${site.pickup}` },
  { t: '0:10', h: 'Площадка', d: 'Экипировка и обучение, 10–15 минут' },
  { t: '0:25', h: 'Маршрут', d: 'Лес, поля, берег реки' },
  { t: 'Вечером', h: 'Видео', d: 'Фото и ролик с поездки у вас в телефоне' },
];
const D = 'M0 52 C 90 20, 160 70, 250 44 S 410 18, 500 46 S 660 74, 750 40 S 910 24, 1000 50';
---
<section class="route" aria-labelledby="route-title" data-route>
  <div class="route__sticky wrap">
  <div class="route__head">
    <h2 id="route-title">Как всё проходит</h2>
    <p class="lede">От звонка до видео в телефоне. С собой ничего не нужно, кроме удобной обуви.</p>
  </div>
  <div class="route__track">
    <div class="route__map" aria-hidden="true">
      <svg class="route__svg" viewBox="0 0 1000 80" preserveAspectRatio="none">
        <path d={D} class="route__base" vector-effect="non-scaling-stroke" />
        <path d={D} class="route__drawn" data-route-path />
      </svg>
      {stops.map((_, i) => <span class="route__pin" data-route-pin={i}></span>)}
      <span class="route__rider" data-route-rider></span>
    </div>
    <ol class="route__stops">
      {stops.map((s) => (
        <li data-route-stop>
          <span class="route__time">{s.t}</span>
          <h3>{s.h}</h3>
          <p>{s.d}</p>
        </li>
      ))}
    </ol>
  </div>
  </div>
</section>

<style>
  /* высокий блок + липкий экран: пока прокручиваешь 160vh, экран стоит, а маршрут проезжается */
  .route { --p: 0; height: 260vh; }
  .route__sticky {
    position: sticky;
    top: 0;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 40px;
    padding-bottom: 40px;
  }
  .route__head { display: flex; justify-content: space-between; align-items: end; gap: 40px; flex-wrap: wrap; margin-bottom: 40px; }
  .route__head h2 { max-width: 14ch; }

  .route__map { position: relative; height: 80px; }
  .route__svg { width: 100%; height: 100%; overflow: visible; }
  .route__svg path { fill: none; }
  .route__base { stroke: var(--ink); stroke-opacity: 0.3; stroke-width: 1.25; stroke-dasharray: 2 7; }
  .route__drawn { stroke: var(--forest); stroke-width: 3; stroke-linecap: round; }

  .route__pin, .route__rider { position: absolute; translate: -50% -50%; border-radius: 50%; }
  .route__pin {
    width: 13px; height: 13px;
    background: var(--paper);
    border: 1.5px solid var(--ink);
    transition: background-color 0.3s, border-color 0.3s, transform 0.4s var(--ease-out);
  }
  .route__pin.is-on { background: var(--forest); border-color: var(--forest); transform: scale(1.25); }
  .route__rider {
    width: 16px; height: 16px;
    background: var(--accent);
    box-shadow: 0 0 0 5px rgb(255 178 63 / 0.3), 0 0 26px 8px rgb(255 178 63 / 0.45);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .route.is-moving .route__rider { opacity: 1; }

  .route__stops {
    list-style: none; margin: 18px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 24px;
  }
  .route__stops li { padding-top: 16px; opacity: 0.42; transition: opacity 0.5s; }
  .route__stops li.is-on { opacity: 1; }
  .route__time { font: 500 13px/1 var(--f-label); color: var(--forest-2); }
  .route__stops h3 { font-size: 32px; margin: 14px 0 10px; }
  .route__stops p { font-size: 14.5px; color: var(--ink-soft); }

  @media (max-width: 860px) {
    .route { height: auto; padding: 90px 0 60px; }
    .route__sticky { position: static; min-height: 0; padding: 0 var(--gutter); }
    .route__map { display: none; }
    /* на телефоне маршрут вертикальный: линия слева заполняется при прокрутке */
    .route__stops { position: relative; grid-template-columns: 1fr; gap: 0; padding-left: 30px; }
    .route__stops::before, .route__stops::after {
      content: ''; position: absolute; left: 6px; top: 6px; bottom: 6px; width: 2px;
    }
    .route__stops::before { background: repeating-linear-gradient(var(--ink) 0 2px, transparent 2px 9px); opacity: 0.35; }
    .route__stops::after { background: var(--forest); transform-origin: top; transform: scaleY(var(--p)); }
    .route__stops li { position: relative; padding: 0 0 30px; }
    .route__stops li::before {
      content: ''; position: absolute; left: -30px; top: 2px; width: 14px; height: 14px; border-radius: 50%;
      background: var(--paper); border: 1.5px solid var(--ink); z-index: 1; transition: background-color 0.3s;
    }
    .route__stops li.is-on::before { background: var(--accent); border-color: var(--forest); }
    .route__stops h3 { margin: 8px 0 6px; font-size: 28px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .route { height: auto; }
    .route__sticky { position: static; min-height: 0; padding-top: 120px; padding-bottom: 80px; }
    .route__stops li { opacity: 1; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-route]');
  const path = root?.querySelector<SVGPathElement>('[data-route-path]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && path) {
    const rider = root.querySelector<HTMLElement>('[data-route-rider]')!;
    const pins = [...root.querySelectorAll<HTMLElement>('[data-route-pin]')];
    const stops = [...root.querySelectorAll<HTMLElement>('[data-route-stop]')];
    const len = path.getTotalLength();
    const n = stops.length;

    // длина пути до точки с нужным x (центр колонки остановки), бинарным поиском
    const lenAtX = (x: number) => {
      let lo = 0, hi = len;
      for (let i = 0; i < 24; i++) {
        const mid = (lo + hi) / 2;
        if (path.getPointAtLength(mid).x < x) lo = mid; else hi = mid;
      }
      return lo;
    };
    const stopLen = stops.map((_, i) => lenAtX(((i + 0.5) / n) * 1000));
    pins.forEach((pin, i) => {
      const pt = path.getPointAtLength(stopLen[i]);
      pin.style.left = `${pt.x / 10}%`;
      pin.style.top = `${(pt.y / 80) * 100}%`;
    });

    path.style.strokeDasharray = `${len}`;
    let raf = 0;
    const render = () => {
      raf = 0;
      const r = root.getBoundingClientRect();
      const vh = innerHeight;
      const mobile = innerWidth <= 860;
      // компьютер: прогресс прокрутки внутри высокого блока, пока экран «прилип»;
      // телефон: от входа списка на 80% высоты экрана до его конца на 60%
      const raw = mobile ? (vh * 0.8 - r.top) / (r.height - vh * 0.2) : -r.top / (r.height - vh);
      const p = reduce ? 1 : Math.min(1, Math.max(0, raw));
      root.style.setProperty('--p', p.toFixed(4));
      const l = p * len;
      path.style.strokeDashoffset = `${len - l}`;
      const pt = path.getPointAtLength(l);
      rider.style.left = `${pt.x / 10}%`;
      rider.style.top = `${(pt.y / 80) * 100}%`;
      root.classList.toggle('is-moving', p > 0.01 && p < 0.995);
      stops.forEach((s, i) => {
        const on = mobile ? p >= i / (n - 1) - 0.02 : l >= stopLen[i] - 2;
        s.classList.toggle('is-on', on);
        pins[i].classList.toggle('is-on', on);
      });
    };
    const ask = () => { if (!raf) raf = requestAnimationFrame(render); };
    addEventListener('scroll', ask, { passive: true });
    addEventListener('resize', ask);
    render();
  }
</script>
